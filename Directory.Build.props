<Project>

  <!-- Centrale package-metadata voor alle projecten in deze repository. Een csproj kan deze waarden overschrijven. -->
  <PropertyGroup>
    <Authors>Rob Lohmann</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.Core.Extensions.Drawing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.Core.Extensions.Drawing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>3.2.6</VersionPrefix>
  </PropertyGroup>

</Project>
