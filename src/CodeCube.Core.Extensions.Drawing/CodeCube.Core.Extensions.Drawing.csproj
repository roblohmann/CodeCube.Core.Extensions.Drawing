<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Rob Lohmann</Authors>
    <Product>CodeCube.Core.Extensions.Drawing</Product>
    <PackageId>CodeCube.Core.Extensions.Drawing</PackageId>
    <Description>Basic set of extensions to perform image related actions</Description>    
    <Copyright>Copyright Rob Lohmann 2021 - 2026</Copyright>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.Core.Extensions.Drawing</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.Core.Extensions.Drawing</RepositoryUrl>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageTags>codecube codecube.core output filter whitespace filter validation attributes</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- versie per TargetFramework staat in Directory.Packages.props -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="nuget-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
